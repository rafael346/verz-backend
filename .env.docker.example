DEBUG=False
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Chave do HMAC do histórico de lances (mín. 32 caracteres). Guarde fora do banco e dos backups dele.
AUDIT_HMAC_KEY=troque-por-outra-chave-longa-e-aleatoria-de-32-ou-mais
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://verz:verz@db:5432/verz
# Atrás de um proxy TLS, deixe o redirecionamento ligado; local sem TLS, desligue.
SECURE_SSL_REDIRECT=False
# 1 = um proxy confiável na frente (o nginx do Compose, que sobrescreve o X-Forwarded-For). 0 só se o backend
# for acessado direto, sem proxy.
NUM_PROXIES=1
