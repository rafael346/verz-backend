DEBUG=True
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Chave do HMAC do histórico de lances (mín. 32 caracteres). Guarde fora do banco e dos backups dele.
AUDIT_HMAC_KEY=troque-por-outra-chave-longa-e-aleatoria-de-32-ou-mais
ALLOWED_HOSTS=localhost,127.0.0.1
# 127.0.0.1, não localhost: o Compose publica o Postgres só no IPv4 do loopback, e localhost tenta o IPv6 antes.
DATABASE_URL=postgres://verz:verz@127.0.0.1:5432/verz
