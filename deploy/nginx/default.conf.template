# Porta de entrada única (D21): /api/ vai direto ao Django; o resto vai ao Next.
# Em ${...} só entram variáveis de ambiente definidas (FRONTEND_UPSTREAM); $remote_addr etc. são do nginx.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

server {
    listen 80;
    server_tokens off;
    client_max_body_size 1m;

    location /api/ {
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Com porta: o CSRF do Django compara a origem do navegador com este host.
        proxy_set_header Host $http_host;
        # Sobrescreve, nunca acrescenta: um X-Forwarded-For forjado pelo cliente não chega ao Django (NUM_PROXIES=1).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Tempo real (SSE): sem buffer e com conexão longa.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    location / {
        proxy_pass http://${FRONTEND_UPSTREAM};
        proxy_http_version 1.1;
        # Upgrade de WebSocket: a recarga automática do `next dev` passa por aqui.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
